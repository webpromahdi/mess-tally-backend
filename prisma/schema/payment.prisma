model Payment {
  id String @id @default(uuid())

  // Workspace & Payer Context (Many-to-One so a Mess can renew every month)
  messId         String
  paidByMemberId String // Which flatmate initiated the checkout

  // Billing Details
  type         PaymentType   @default(SUBSCRIPTION_MONTHLY)
  status       PaymentStatus @default(UNPAID)
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("BDT")
  durationDays Int           @default(30)

  // Subscription Coverage Window
  periodStart DateTime?
  periodEnd   DateTime?

  // bKash Request & Execution Identifiers
  paymentGateway        String    @default("bkash")
  merchantInvoiceNumber String    @unique // Required by bKash createPayment (e.g. "INV-202610-X89A")
  bkashPaymentId        String?   @unique // Returned by bKash createPayment
  bkashTrxId            String?   @unique // Returned by bKash executePayment (trxID)
  payerReference        String?   // User phone/email sent in bKash createPayment payload
  paidAt                DateTime? // Server timestamp when payment completed

  // Full raw JSON response from bKash executePayment (stores customerMsisdn, raw timestamps, etc.)
  gatewayResponse Json?

  // bKash Refund Tracking
  refundTrxId  String?   @unique
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Restrict)
  paidBy MessMember @relation("MemberSaasPayments", fields: [paidByMemberId], references: [id], onDelete: Restrict)

  @@index([messId, status])
  @@index([messId, createdAt])
  @@index([paidByMemberId])
  @@map("payments")
}
