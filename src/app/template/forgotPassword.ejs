<%#
    MessTally — forgot password OTP
    Expected locals: name, email, otp, expirationMinutes
    Email-client safe: table layout, inline styles, no external assets.
%>
<%
    const recipientName = (typeof name !== "undefined" && name) ? name : "there";
    const recipientEmail = (typeof email !== "undefined" && email) ? email : "your email";
    const code = (typeof otp !== "undefined" && otp) ? otp : "------";
    const minutes = (typeof expirationMinutes !== "undefined" && expirationMinutes) ? expirationMinutes : 5;
%>
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>Reset your MessTally password</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
    <style>
        /* Client resets */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        a { text-decoration: none; }

        /* Preheader: preview text only */
        .preheader {
            display: none !important;
            visibility: hidden;
            opacity: 0;
            color: transparent;
            height: 0;
            width: 0;
            max-height: 0;
            max-width: 0;
            overflow: hidden;
            mso-hide: all;
            font-size: 1px;
            line-height: 1px;
        }

        /* Mobile */
        @media only screen and (max-width: 620px) {
            .mt-canvas-pad { padding: 20px 10px !important; }
            .mt-shell { width: 100% !important; }
            .mt-head { padding: 22px 24px !important; }
            .mt-body { padding: 30px 24px 8px !important; }
            .mt-ticket-pad { padding: 22px 24px !important; }
            .mt-code { font-size: 30px !important; letter-spacing: 8px !important; }
            .mt-note-wrap { padding: 12px 24px 28px !important; }
            .mt-footer { padding: 22px 24px !important; }
            .mt-h1 { font-size: 25px !important; line-height: 33px !important; }
        }

        /* Dark mode */
        @media (prefers-color-scheme: dark) {
            .mt-canvas { background-color: #0B1413 !important; }
            .mt-shell { background-color: #111C1A !important; }
            .mt-body, .mt-h1, .mt-text { color: #E6EFEC !important; }
            .mt-footer { background-color: #0D1816 !important; border-top-color: #1F302C !important; }
            .mt-ticket { background-color: #152420 !important; border-color: #2A4A42 !important; }
            .mt-code { color: #F7FBFA !important; }
            .mt-badge { background-color: #1E3A32 !important; color: #B7E3D4 !important; }
            .mt-step-title { color: #E6EFEC !important; }
            .mt-step-text { color: #A6B8B3 !important; }
            .mt-step-num { background-color: #1E3A32 !important; color: #B7E3D4 !important; }
            .mt-note { background-color: #2A2110 !important; border-left-color: #F2B01E !important; }
            .mt-note-title { color: #FFD98A !important; }
            .mt-note-text { color: #D8C9A8 !important; }
            .mt-divider { background-color: #243532 !important; }
            .mt-foot-text { color: #7E908B !important; }
            .mt-foot-link { color: #9FD8C7 !important; }
        }
    </style>
</head>
<body class="mt-canvas" style="margin:0; padding:0; background-color:#EAF2EF; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
    <!-- Preview text (shown in inbox list, hidden in the email body) -->
    <div class="preheader">
        Your MessTally password reset code is <%= code %>. It expires in <%= minutes %> minutes.
    </div>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="mt-canvas" style="background-color:#EAF2EF;">
        <tr>
            <td align="center" class="mt-canvas-pad" style="padding:36px 14px;">

                <!--[if mso]>
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600"><tr><td>
                <![endif]-->

                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" class="mt-shell" style="width:100%; max-width:600px; background-color:#FFFFFF; border-radius:18px; overflow:hidden; box-shadow:0 18px 40px rgba(10,42,38,0.10);">

                    <!-- Brand header -->
                    <tr>
                        <td class="mt-head" style="background-color:#0A2A26; padding:26px 40px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="left" valign="middle" width="44" style="width:44px;">
                                        <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td width="38" height="38" align="center" valign="middle" style="width:38px; height:38px; background-color:#F2B01E; border-radius:11px; font-family:Georgia,'Times New Roman',serif; font-size:20px; line-height:38px; font-weight:bold; color:#0A2A26; mso-line-height-rule:exactly;">
                                                    M
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td align="left" valign="middle" style="padding-left:12px;">
                                        <div style="font-family:Georgia,'Times New Roman',serif; font-size:20px; line-height:24px; font-weight:bold; color:#FFFFFF; letter-spacing:0.2px; mso-line-height-rule:exactly;">
                                            MessTally
                                        </div>
                                        <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; letter-spacing:1.6px; text-transform:uppercase; color:#8FB7AC; padding-top:3px; mso-line-height-rule:exactly;">
                                            Mess management, tallied
                                        </div>
                                    </td>
                                    <td align="right" valign="middle" style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; letter-spacing:1.4px; text-transform:uppercase; color:#6F9A8E;">
                                        <span style="display:inline-block; border:1px solid #2E5B51; border-radius:999px; padding:5px 10px; color:#9CC3B7;">
                                            Reset password
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Accent rule -->
                    <tr>
                        <td height="4" style="height:4px; line-height:4px; font-size:0; background-color:#F2B01E;">&nbsp;</td>
                    </tr>

                    <!-- Hero -->
                    <tr>
                        <td class="mt-body" style="padding:40px 40px 6px;">
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; letter-spacing:2px; text-transform:uppercase; color:#12796A; padding-bottom:12px;">
                                Password reset
                            </div>
                            <h1 class="mt-h1" style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:29px; line-height:38px; font-weight:normal; color:#13201E; letter-spacing:-0.2px;">
                                Forgot your password, <%= recipientName %>?
                            </h1>
                            <p class="mt-text" style="margin:16px 0 0; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px; color:#3E4F4B;">
                                We received a request to reset the password for your MessTally account. Enter the six-digit code below in the app to choose a new password.
                            </p>
                        </td>
                    </tr>

                    <!-- OTP ticket -->
                    <tr>
                        <td class="mt-ticket-pad" style="padding:18px 40px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="mt-ticket" style="background-color:#F3FAF7; border:1px dashed #B9DCD2; border-radius:14px;">
                                <tr>
                                    <td style="padding:26px 28px 24px;">
                                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td align="left" valign="middle" style="font-family:Arial,Helvetica,sans-serif; font-size:10px; line-height:14px; letter-spacing:2px; text-transform:uppercase; color:#5B6B68;">
                                                    Your reset code
                                                </td>
                                                <td align="right" valign="middle">
                                                    <span class="mt-badge" style="display:inline-block; background-color:#E1F1EA; border-radius:999px; padding:4px 10px; font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; color:#0F5B4F; white-space:nowrap;">
                                                        Expires in <%= minutes %> min
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" align="center" style="padding:18px 0 10px;">
                                                    <div class="mt-code" style="font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,Courier,monospace; font-size:38px; line-height:46px; font-weight:bold; letter-spacing:12px; color:#0A2A26; white-space:nowrap;">
                                                        <%= code %>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" align="center" style="font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:18px; color:#5B6B68; padding-bottom:2px;">
                                                    Paste it into the password reset screen in the MessTally app.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- What happens next -->
                    <tr>
                        <td style="padding:14px 40px 6px;">
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; letter-spacing:2px; text-transform:uppercase; color:#8A9A96; padding-bottom:18px;">
                                What happens next
                            </div>
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td width="34" valign="top" style="width:34px; padding-bottom:18px;">
                                        <div class="mt-step-num" style="width:26px; height:26px; background-color:#E1F1EA; border-radius:999px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:26px; font-weight:bold; color:#0F5B4F; text-align:center; mso-line-height-rule:exactly;">
                                            1
                                        </div>
                                    </td>
                                    <td valign="top" style="padding-bottom:18px;">
                                        <div class="mt-step-title" style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#13201E;">
                                            Enter this code
                                        </div>
                                        <div class="mt-step-text" style="font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#5B6B68; padding-top:3px;">
                                            Type the six-digit code above on the reset screen to prove the account belongs to you.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="34" valign="top" style="width:34px; padding-bottom:18px;">
                                        <div class="mt-step-num" style="width:26px; height:26px; background-color:#E1F1EA; border-radius:999px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:26px; font-weight:bold; color:#0F5B4F; text-align:center; mso-line-height-rule:exactly;">
                                            2
                                        </div>
                                    </td>
                                    <td valign="top" style="padding-bottom:18px;">
                                        <div class="mt-step-title" style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#13201E;">
                                            Choose a new password
                                        </div>
                                        <div class="mt-step-text" style="font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#5B6B68; padding-top:3px;">
                                            Pick something you haven't used before — at least eight characters with a letter and a number.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="34" valign="top" style="width:34px;">
                                        <div class="mt-step-num" style="width:26px; height:26px; background-color:#E1F1EA; border-radius:999px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:26px; font-weight:bold; color:#0F5B4F; text-align:center; mso-line-height-rule:exactly;">
                                            3
                                        </div>
                                    </td>
                                    <td valign="top">
                                        <div class="mt-step-title" style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#13201E;">
                                            Sign back in
                                        </div>
                                        <div class="mt-step-text" style="font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#5B6B68; padding-top:3px;">
                                            Your meals, dues and month-end totals are exactly where you left them.
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Security note -->
                    <tr>
                        <td class="mt-note-wrap" style="padding:12px 40px 34px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="mt-note" style="background-color:#FFF8E6; border-left:3px solid #F2B01E; border-radius:10px;">
                                <tr>
                                    <td style="padding:16px 18px;">
                                        <div class="mt-note-title" style="font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:18px; font-weight:bold; color:#7A5A05; letter-spacing:0.3px;">
                                            Keep this code to yourself
                                        </div>
                                        <div class="mt-note-text" style="font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:19px; color:#6B5A2E; padding-top:5px;">
                                            MessTally will never ask for it over a call, WhatsApp or a reply to this email. It works once and dies in <%= minutes %> minutes. If you didn't request a password reset, ignore this message — your password stays unchanged.
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td class="mt-footer" style="background-color:#F7FBFA; border-top:1px solid #E4EDEA; padding:26px 40px 30px;">
                            <div class="mt-foot-text" style="font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:19px; color:#6B7B77;">
                                Sent to <span class="mt-foot-link" style="color:#0F5B4F; font-weight:bold;"><%= recipientEmail %></span> because a password reset was requested for this MessTally account.
                            </div>
                            <div class="mt-divider" style="height:1px; line-height:1px; font-size:0; background-color:#E4EDEA; margin:16px 0;">&nbsp;</div>
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="left" valign="middle" class="mt-foot-text" style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:17px; color:#8A9A96;">
                                        <span style="font-family:Georgia,'Times New Roman',serif; font-size:12px; color:#0F5B4F; font-weight:bold;">MessTally</span>
                                        &nbsp;·&nbsp; Mess management, tallied.
                                    </td>
                                    <td align="right" valign="middle" class="mt-foot-text" style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:17px; color:#A3B1AD;">
                                        Automated message
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>

                <!--[if mso]>
                </td></tr></table>
                <![endif]-->

                <div class="mt-foot-text" style="font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:18px; color:#9AA9A5; text-align:center; padding:18px 20px 0;">
                    This code expires in <%= minutes %> minutes. Need a new one? Request another from the forgot-password screen.
                </div>

            </td>
        </tr>
    </table>
</body>
</html>
